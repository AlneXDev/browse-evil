{
  "manifest_version": 3,
  "name": "OpenCode Eʌil Browse",
  "description": "Lets your coding agent use your real browser: open and drive tabs, take screenshots, and hand logins back to you. Made by ✧Alne.",
  "version": "0.1.5",
  "minimum_chrome_version": "125",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "OpenCode Eʌil Browse — Click to let agents use this tab",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "webNavigation",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
