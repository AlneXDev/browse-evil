[Unit]
Description=Headed canary %i, released extension, persistent profile
Requires=browsevil-canary-display.service browsevil-canary-install.service
After=browsevil-canary-display.service browsevil-canary-install.service
PartOf=browsevil-canary.service

[Service]
User=canary
EnvironmentFile=/etc/browsevil-canary.env
UnsetEnvironment=OPENCODE_BROWSEVIL_HOME
UMask=0077
ExecStart=/bin/bash /opt/browsevil-canary/stress/canary/browser.sh %i
ExecStartPost=/usr/local/bin/node /opt/browsevil-canary/stress/canary/profile.ts %i
TimeoutStartSec=90
TimeoutStopSec=10
